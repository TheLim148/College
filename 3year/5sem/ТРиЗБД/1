-- Посмотреть расписание с названиями представлений
select s.*, p.title 
from sessions s 
join performances p on s.performance_id = p.id;

-- Посмотреть цены на билеты с информацией о сеансах
select pr.*, s.session_date, s.session_time, p.title
from pricing pr
join sessions s on pr.session_id = s.id
join performances p on s.performance_id = p.id;

