-- 1. Создайте представление для анализа заказов и INSTEAD OF триггер для управления данными
create view v_order_analysis as
select 
    o.order_id,
    pp.address,
    p.product_name,
    o.order_date,
    o.quantity,
    p.price,
    o.total_amount
from orders o
join pickup_point pp on o.point_id = pp.point_id
join products p on o.product_id = p.product_id;

select * from v_order_analysis;

---

create or replace function instead_of_analysis_trigger()
returns trigger as $$
begin
    if tg_op = 'INSERT' then
        insert into orders (point_id, product_id, order_date, quantity, total_amount)
        values (
            (select point_id from pickup_point where address = new.address),
            (select product_id from products where product_name = new.product_name),
            new.order_date,
            new.quantity,
            new.quantity * (select price from products where product_name = new.product_name)
        );
        return new;
    end if;
    return null;
end $$ language plpgsql;

create trigger instead_of_analysis_trigger
instead of insert on v_order_analysis
for each row execute function instead_of_analysis_trigger();

