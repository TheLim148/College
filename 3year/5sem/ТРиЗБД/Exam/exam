-- 3. Создание хранимых процедур и функций:
-- 3.1. Создайте хранимую процедуру: оптимизация товарных запасов точек выдачи
create or replace procedure optimize_inventory()
as $$
declare
    inventory_record record;
begin
    create temp table if not exists inventory_results (
        point_id integer,
        address text,
        product_id integer,
        product_name text,
        avg_quantity numeric(10,2),
        recommendation text
    );
    
    truncate inventory_results;
    
    insert into inventory_results
    with stats as (
        select 
            o.point_id,
            o.product_id,
            avg(o.quantity) as avg_quantity,
            stddev(o.quantity) as quantity_stddev
        from orders o
        group by o.point_id, o.product_id
    )
    select 
        pp.point_id,
        pp.address,
        p.product_id,
        p.product_name,
        st.avg_quantity,
        case 
            when st.avg_quantity > 100 then 'Избыточный инвентарь'
            when st.avg_quantity < 10 then 'Бедный инвентарь'
            else 'Нормальный инвентарь'
        end as recommendation
    from stats st
    join pickup_point pp on st.point_id = pp.point_id
    join products p on st.product_id = p.product_id;
    
    for inventory_record in 
        select * from inventory_results order by point_id, product_id
    loop
        raise notice 'Код Точки: %, Адрес: %, Товар: %, Среднее количество: %, Рекомендация: %',
            inventory_record.point_id,
            inventory_record.address,
            inventory_record.product_name,
            inventory_record.avg_quantity,
            inventory_record.recommendation;
    end loop;
    
end $$ language plpgsql;


call optimize_inventory();

-- 3.2. Создайте хранимую функцию: анализ сезонности спроса на товары
create or replace function analyze_seasonality(analysis_year integer default null)
returns table (
    product_name text,
    quarter integer,
    avg_volume numeric(10,2),
    demand_level text
) as $$
declare
    overall_avg numeric(10,2);
begin
    if analysis_year is null then
        analysis_year := extract(year from current_date);
    end if;

    select avg(seasonal_data.avg_volume) into overall_avg
    from (
        select 
            p.product_name,
            extract(quarter from o.order_date) as quarter,
            avg(o.quantity) as avg_volume
        from orders o
        join products p on o.product_id = p.product_id
        where extract(year from o.order_date) = analysis_year
        group by p.product_name, extract(quarter from o.order_date)
    ) as seasonal_data;

    return query
    with seasonal_data as (
        select 
            p.product_name,
            extract(quarter from o.order_date) as quarter,
            avg(o.quantity) as avg_volume
        from orders o
        join products p on o.product_id = p.product_id
        where extract(year from o.order_date) = analysis_year
        group by p.product_name, extract(quarter from o.order_date)
    )
    select 
        sd.product_name,
        sd.quarter::integer,
        sd.avg_volume,
        case 
            when sd.avg_volume > overall_avg * 1.2 then 'Высокий'
            when sd.avg_volume < overall_avg * 0.8 then 'Низкий'
            else 'Средний'
        end as demand_level
    from seasonal_data sd
    order by sd.product_name, sd.quarter;
end $$ language plpgsql;


select * from analyze_seasonality(2025);