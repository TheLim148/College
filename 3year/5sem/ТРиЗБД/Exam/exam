-- 2. Реализуйте триггер для автоматического расчета суммы с проверкой наличия товара
create or replace function calculate_order_total()
returns trigger as $$
declare
    product_price numeric(10,2);
begin
    select price into product_price 
    from products 
    where product_id = new.product_id;
    
    if product_price is null then
        raise exception 'Товара с айди % не существует', new.product_id;
    end if;
    
    new.total_amount := new.quantity * product_price;
    
    return new;
end $$ language plpgsql;

create trigger calculate_order_total_trigger
before insert or update on orders
for each row execute function calculate_order_total();

